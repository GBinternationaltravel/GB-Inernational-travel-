# =============================================================================
# GB International Travel — Environment Variables (EXAMPLE ONLY)
# Copy to .env / .env.staging / host secrets manager. NEVER commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# SHARED / PUBLIC (safe to expose to browser)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="GB International Travel"
NEXT_PUBLIC_DEFAULT_CURRENCY="PKR"
NEXT_PUBLIC_DEFAULT_LOCALE="en"
# Public contact channels for Quick Assistance (safe for frontend)
NEXT_PUBLIC_CONTACT_EMAIL="gb.intltravel@gmail.com"
NEXT_PUBLIC_CONTACT_PHONE="+92 346 2559008"
NEXT_PUBLIC_CONTACT_WHATSAPP="+971 52 205 1485"

# Logical deploy target: development | staging | production
# Staging hosts should set APP_ENV=staging (usually with NODE_ENV=production).
APP_ENV="development"

# -----------------------------------------------------------------------------
# DATABASE (required for staging + production)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Use SEPARATE databases/credentials for development, staging, and production.
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gb_international_travel?schema=public"

# Force Prisma stores (REQUIRED for staging + production — never "file")
BOOKING_STORE="prisma"
AUTH_STORE="prisma"
NOTIFICATION_STORE="prisma"
PAYMENT_STORE="prisma"

# -----------------------------------------------------------------------------
# AUTH / SECURITY
# Generate long random values; different per environment.
# -----------------------------------------------------------------------------
SESSION_SECRET="change-me-to-a-long-random-secret"
AUTH_SECRET="change-me-to-a-long-random-auth-secret"

BOOKING_DRAFT_EXPIRY_MINUTES="60"

# -----------------------------------------------------------------------------
# DEVELOPMENT defaults (local laptop)
# -----------------------------------------------------------------------------
# FLIGHT_SUPPLIER="mock"
# PAYMENT_PROVIDER="MOCK"
# EMAIL_PROVIDER="console"
# WEATHER_PROVIDER="mock"
# FLIGHT_STATUS_PROVIDER="mock"
# Ticket issuer mode is set in Admin → Settings (use MANUAL)

# Demo seed passwords (development only — never use in staging/production)
# DEMO_CUSTOMER_PASSWORD=""
# DEMO_ADMIN_PASSWORD=""

# -----------------------------------------------------------------------------
# STAGING recommended profile (safe — no live money / no live tickets)
# -----------------------------------------------------------------------------
# APP_ENV="staging"
# NODE_ENV="production"
# NEXT_PUBLIC_APP_URL="https://staging.example.com"
# DATABASE_URL="postgresql://STAGING_USER:STAGING_PASSWORD@STAGING_HOST:5432/gb_travel_staging?schema=public"
# BOOKING_STORE="prisma"
# AUTH_STORE="prisma"
# NOTIFICATION_STORE="prisma"
# PAYMENT_STORE="prisma"
# SESSION_SECRET="<staging-only-secret>"
# AUTH_SECRET="<staging-only-secret>"
# REMINDER_CRON_SECRET="<staging-only-cron-secret>"
#
# Flights: mock OR Travelport sandbox (never invent credentials)
# FLIGHT_SUPPLIER="mock"
# FLIGHT_SUPPLIER="travelport"
# TRAVELPORT_ENVIRONMENT="sandbox"
# TRAVELPORT_CLIENT_ID=""
# TRAVELPORT_CLIENT_SECRET=""
# TRAVELPORT_USERNAME=""
# TRAVELPORT_PASSWORD=""
# TRAVELPORT_ACCESS_GROUP=""
# TRAVELPORT_ENABLE_SANDBOX_BOOKING="false"
#
# Payments: MOCK (or Safepay sandbox only). Live Safepay is blocked in code.
# PAYMENT_PROVIDER="MOCK"
# ALLOW_MOCK_PAYMENTS="true"
# PAYMENT_WEBHOOK_SECRET="<staging-webhook-secret>"
# SAFEPAY_ENVIRONMENT="sandbox"
# SAFEPAY_API_KEY=""
# SAFEPAY_SECRET=""
# SAFEPAY_WEBHOOK_SECRET=""
#
# Email: console OR Resend (optional — staging can proceed without Resend)
# EMAIL_PROVIDER="console"
# EMAIL_PROVIDER="resend"
# RESEND_API_KEY=""
# EMAIL_FROM="GB International Travel <noreply@yourdomain.com>"
#
# Weather / flight status: mock unless real keys exist
# WEATHER_PROVIDER="mock"
# FLIGHT_STATUS_PROVIDER="mock"

# -----------------------------------------------------------------------------
# PRODUCTION — official domain only
# https://www.gbinternationaltravels.com/
# Set these on Vercel Production. NEVER commit real secrets.
# Live Travelport / live Safepay / auto-ticketing remain blocked in code.
# -----------------------------------------------------------------------------
# APP_ENV="production"
# NODE_ENV="production"
# NEXT_PUBLIC_APP_URL="https://www.gbinternationaltravels.com"
# NEXT_PUBLIC_APP_NAME="GB International Travel"
# NEXT_PUBLIC_DEFAULT_CURRENCY="PKR"
# NEXT_PUBLIC_DEFAULT_LOCALE="en"
# DATABASE_URL="postgresql://PRODUCTION_USER:PRODUCTION_PASSWORD@HOSTED_HOST:5432/gb_travel_production?schema=public"
# BOOKING_STORE="prisma"
# AUTH_STORE="prisma"
# NOTIFICATION_STORE="prisma"
# PAYMENT_STORE="prisma"
# SESSION_SECRET="<production-only-secret>"
# AUTH_SECRET="<production-only-secret>"
# REMINDER_CRON_SECRET="<production-only-cron-secret>"
# CRON_SECRET="<same-value-as-vercel-cron-or-reminder-secret>"
# FLIGHT_SUPPLIER="mock"
# PAYMENT_PROVIDER="MOCK"
# ALLOW_MOCK_PAYMENTS="true"
# EMAIL_PROVIDER="console"
# WEATHER_PROVIDER="mock"
# FLIGHT_STATUS_PROVIDER="mock"

# -----------------------------------------------------------------------------
# WEATHER
# -----------------------------------------------------------------------------
WEATHER_PROVIDER="mock"
# WEATHER_PROVIDER="openweathermap"
# WEATHER_API_KEY=""
# WEATHER_BASE_URL="https://api.openweathermap.org/data/2.5"
# WEATHER_TIMEOUT_MS="8000"
# WEATHER_CACHE_TTL_SECONDS="1800"
# WEATHER_MAX_REQUESTS_PER_MINUTE="30"

# -----------------------------------------------------------------------------
# EMAIL / REMINDERS
# -----------------------------------------------------------------------------
EMAIL_PROVIDER="console"
# EMAIL_PROVIDER="resend"
# RESEND_API_KEY=""
# EMAIL_FROM="GB International Travel <noreply@yourdomain.com>"
# EMAIL_TIMEOUT_MS="10000"
# ALLOW_OPTIONAL_EMAILS_WITHOUT_OPT_IN="false"

# Protects POST/GET /api/internal/reminders/run
REMINDER_CRON_SECRET="change-me-long-random-secret"
# Vercel Cron injects Authorization: Bearer <CRON_SECRET> — set the same value on Vercel
# CRON_SECRET="change-me-long-random-secret"
# Scheduler example (secret never logged):
# curl -X POST "https://www.gbinternationaltravels.com/api/internal/reminders/run" \
#   -H "Authorization: Bearer $REMINDER_CRON_SECRET"
# See docs/VERCEL.md

# -----------------------------------------------------------------------------
# FLIGHT STATUS
# -----------------------------------------------------------------------------
FLIGHT_STATUS_PROVIDER="mock"
# FLIGHT_STATUS_PROVIDER="aviationstack"
# FLIGHT_STATUS_API_KEY=""
# FLIGHT_STATUS_BASE_URL="http://api.aviationstack.com/v1"
# FLIGHT_STATUS_TIMEOUT_MS="8000"

# -----------------------------------------------------------------------------
# PAYMENTS
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER="MOCK"
# PAYMENT_STORE="prisma"
# PAYMENT_WEBHOOK_SECRET="change-me-dev-webhook-secret"
# ALLOW_MOCK_PAYMENTS="true"
#
# Safepay SANDBOX only (leave empty without official sandbox credentials)
# Never set SAFEPAY_ENVIRONMENT=production in this phase.
# SAFEPAY_ENVIRONMENT="sandbox"
# SAFEPAY_API_KEY=""
# SAFEPAY_SECRET=""
# SAFEPAY_WEBHOOK_SECRET=""

# -----------------------------------------------------------------------------
# FLIGHT SUPPLIER
# -----------------------------------------------------------------------------
FLIGHT_SUPPLIER="mock"
# MOCK_FLIGHT_NO_AVAILABILITY="false"
# MOCK_FLIGHT_FORCE_EXPIRE="false"
# MOCK_FLIGHT_PRICE_CHANGE="false"
# MOCK_FLIGHT_TIMEOUT="false"

# Travelport SANDBOX / pre-production only (production environment forced off in code)
# TRAVELPORT_ENVIRONMENT="sandbox"
# TRAVELPORT_BASE_URL="https://api.pp.travelport.net/11/air"
# TRAVELPORT_AUTH_URL="https://auth.pp.travelport.net/oauth/token"
# TRAVELPORT_CLIENT_ID=""
# TRAVELPORT_CLIENT_SECRET=""
# TRAVELPORT_USERNAME=""
# TRAVELPORT_PASSWORD=""
# TRAVELPORT_PCC=""
# TRAVELPORT_ACCESS_GROUP=""
# TRAVELPORT_GDS="1G"
# TRAVELPORT_API_VERSION="11"
# TRAVELPORT_ALLOW_MOCK_FALLBACK="false"
# TRAVELPORT_ENABLE_SANDBOX_BOOKING="false"

# Health: GET /api/health/ready
# Schema: prefer db push for staging until baseline migration is baselined — see docs/DATABASE_MIGRATIONS.md
# NEVER run: prisma migrate reset / db push --force-reset
